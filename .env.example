# Neon Postgres (Vercel Marketplace → Neon). Use the pooled connection string.
DATABASE_URL=

# Vercel Blob (Storage → Blob). Added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=

# 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=
# Only this username can create the owner account on an empty database.
# OWNER_USERNAME=gilgoldman

# Google AI Studio key. Model can be overridden.
GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# Used automatically while the main model is overloaded.
# LLM_FALLBACK_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-2

# Public URL of the deployment, e.g. https://cookbook.vercel.app
APP_URL=

# Telegram (optional): token from @BotFather, any random secret, and the bot's username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
