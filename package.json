{
  "name": "cookbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build && tsx scripts/telegram-sync.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "telegram:sync": "tsx scripts/telegram-sync.ts",
    "reembed": "tsx scripts/reembed.ts",
    "translate": "NODE_OPTIONS=--conditions=react-server tsx scripts/translate.ts",
    "seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.82",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.118",
    "bcryptjs": "^3.0.3",
    "botid": "^1.5.11",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
